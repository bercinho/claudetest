<?xml version="1.0" encoding="utf-8"?>
<!--
  The same house mark the web app uses for its icon, redrawn as a vector so the
  launcher can animate and reshape it.

  Adaptive icons are 108dp with only the middle 72dp guaranteed visible and the
  middle 66dp guaranteed uncropped by any launcher shape. The mark is drawn in
  its original 64-unit space and scaled up so that its widest point spans 54dp
  across the centre — big enough to read at launcher size, small enough that no
  launcher shape can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="10.8"
        android:translateY="10.8"
        android:scaleX="1.35"
        android:scaleY="1.35">

        <path
            android:pathData="M32,13L12,29v3h6v19h13V39h6v12h13V32h6v-3L32,13Z"
            android:fillColor="#FFFFFF" />

        <!-- Reads as a hole punched through to the background layer. -->
        <path
            android:pathData="M32,22a4,4 0 1,0 0,8a4,4 0 1,0 0,-8Z"
            android:fillColor="#6C4CE0" />
    </group>
</vector>
